# 账号名称必须与 `uv run python checkin.py add <name>` 使用的 name 一致
# 示例名称仅用于本地 Profile 标识，不需要与 GitHub 用户名一致
AGENTROUTER_ACCOUNTS=["account1","account2"]

# 本机代理 HTTP / mixed 端口。AgentRouter / GitHub 能直连时可留空。
CHECKIN_PROXY_URL=http://127.0.0.1:7890

# 自动签到建议 headless=true；首次 add 会强制打开浏览器
CHECKIN_HEADLESS=true
CHECKIN_HUMANIZE=true
CHECKIN_WAIT_TIMEOUT_MS=120000

# 通常无需修改
AGENTROUTER_DOMAIN=https://agentrouter.org

# 调试时可开启
DEBUG_MODE=false
